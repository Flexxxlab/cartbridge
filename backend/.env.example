BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./cartbridge.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (pip install psycopg[binary])

# SMTP (leave SMTP_HOST empty to print emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CartBridge <no-reply@yourdomain.com>
SMTP_STARTTLS=true

# Walmart: mock | affiliate
WALMART_PROVIDER=mock
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_PATH=./walmart_private_key.pem
WALMART_PUBLISHER_ID=
